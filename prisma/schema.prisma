generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserType {
  PASSENGER
  DRIVER
  BOTH
}

enum VerificationDocumentType {
  STUDENT_ID
  DRIVING_LICENCE
  VEHICLE_RC
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  REUPLOAD_REQUIRED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum PassengerGenderPreference {
  ANY
  FEMALE
}

enum RideStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EmergencyAlertStatus {
  ACTIVE
  RESOLVED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PARTIALLY_PAID
  SUCCEEDED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
}

model User {
  id                        String             @id @default(cuid())
  name                      String
  email                     String             @unique
  password                  String
  role                      Role               @default(USER)
  userType                  UserType           @default(PASSENGER)
  status                    UserStatus         @default(ACTIVE)
  gender                    Gender?            @default(PREFER_NOT_TO_SAY)
  phoneNumber               String?
  emergencyContactName      String?
  emergencyContactEmail     String?
  emergencyContactPhone     String?
  studentVerificationStatus VerificationStatus @default(NOT_SUBMITTED)
  driverVerificationStatus  VerificationStatus @default(NOT_SUBMITTED)
  createdAt                 DateTime           @default(now())
  rides                     Ride[]             @relation("DriverRides")
  bookings                  Booking[]
  messages                  Message[]
  verifications             Verification[]     @relation("UserVerifications")
  reviewedVerifications     Verification[]     @relation("AdminVerifications")
  reportsSubmitted          Report[]           @relation("ReporterUser")
  reportsReceived           Report[]           @relation("ReportedUser")
  blocksInitiated           Block[]            @relation("BlocksInitiated")
  blocksReceived            Block[]            @relation("BlocksReceived")
  emergencyAlerts           EmergencyAlert[]
  ratingsGiven              Rating[]           @relation("RatingsGiven")
  ratingsReceived           Rating[]           @relation("RatingsReceived")
  trustedContacts           TrustedContact[]   @relation("UserContacts")
  sharedTokens              TripShareToken[]   @relation("SharedTokens")
  payments                  Payment[]          @relation("UserPayments")
}

model Ride {
  id              String           @id @default(cuid())
  driverId        String
  origin          String
  originLat       Float?
  originLon       Float?
  destination     String
  destLat         Float?
  destLon         Float?
  departure       DateTime
  seats           Int
  price           Float            @default(0)
  rideType        String           @default("Private Pool")
  vehicleName     String           @default("")
  distance        Float?
  duration        Int?
  status          RideStatus       @default(SCHEDULED)
  currentLat      Float?
  currentLon      Float?
  isLiveSharing   Boolean          @default(false)
  locationUpdatedAt DateTime?
  routeGeometry   String?
  routeUpdatedAt  DateTime?
  baseRouteGeometry String?
  baseDistance    Float?
  createdAt       DateTime         @default(now())
  driver          User             @relation("DriverRides", fields: [driverId], references: [id])
  bookings        Booking[]
  messages        Message[]
  reports         Report[]
  emergencyAlerts EmergencyAlert[]
  ratings         Rating[]
  shareTokens     TripShareToken[]
  payments        Payment[]
}

model Booking {
  id                      String                    @id @default(cuid())
  rideId                  String
  userId                  String
  seats                   Int                       @default(1)
  fare                    Float                     @default(0)
  mainFare                Float?                    @default(0)
  detourFare              Float?                    @default(0)
  detourDistance          Float?                    @default(0)
  fareBreakdown           String?
  previousFare            Float?                    @default(0)
  fareVersion             Int                       @default(1)
  fareUpdatedAt           DateTime?                 @default(now())
  fareChangeReason        String?
  status                  String                    @default("PENDING") // PENDING, CONFIRMED, CANCELLED, REJECTED
  preferredPassengerGender PassengerGenderPreference @default(ANY)
  pickupLocation          String?
  pickupLat               Float?
  pickupLon               Float?
  dropLocation            String?
  dropLat                 Float?
  dropLon                 Float?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?                 @updatedAt
  ride                    Ride                      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencyAlerts         EmergencyAlert[]
  ratings                 Rating[]
  shareTokens             TripShareToken[]
  payment                 Payment?
  paymentAudits           PaymentAudit[]
}

model EmergencyAlert {
  id          String               @id @default(cuid())
  userId      String
  rideId      String
  bookingId   String
  status      EmergencyAlertStatus @default(ACTIVE)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime             @default(now())
  resolvedAt  DateTime?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ride        Ride                 @relation(fields: [rideId], references: [id], onDelete: Cascade)
  booking     Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Rating {
  id          String   @id @default(cuid())
  rideId      String
  bookingId   String?
  reviewerId  String
  revieweeId  String
  rating      Int
  review      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ride        Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  reviewer    User     @relation("RatingsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee    User     @relation("RatingsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([rideId, reviewerId, revieweeId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  rideId    String
  userId    String
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id              String                   @id @default(cuid())
  userId          String
  documentType    VerificationDocumentType
  filePath        String
  fileName        String
  fileType        String
  status          VerificationStatus       @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime                 @default(now())
  reviewedAt      DateTime?
  adminId         String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  user            User                     @relation("UserVerifications", fields: [userId], references: [id], onDelete: Cascade)
  admin           User?                    @relation("AdminVerifications", fields: [adminId], references: [id], onDelete: SetNull)
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String?
  rideId         String?
  reason         String
  description    String?
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  reporter       User         @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  ride           Ride?        @relation(fields: [rideId], references: [id], onDelete: SetNull)
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model TrustedContact {
  id          String   @id @default(cuid())
  userId      String
  name        String
  phone       String
  isEmergency Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@index([userId])
}

model TripShareToken {
  id              String    @id @default(cuid())
  token           String    @unique
  rideId          String
  userId          String
  bookingId       String?
  recipientName   String?
  recipientPhone  String?
  isRevoked       Boolean   @default(false)
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ride            Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user            User      @relation("SharedTokens", fields: [userId], references: [id], onDelete: Cascade)
  booking         Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([token])
  @@index([rideId])
  @@index([userId])
}

model Payment {
  id                 String        @id @default(cuid())
  bookingId          String        @unique
  rideId             String
  userId             String
  amount             Float
  amountSubunits     Int
  amountPaid         Float?        @default(0)
  finalFare          Float?
  outstandingBalance Float?        @default(0)
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)
  provider           String        @default("RAZORPAY")
  providerOrderId    String        @unique
  providerPaymentId  String?       @unique
  providerSignature  String?
  paymentMethod      PaymentMethod?
  idempotencyKey     String        @unique
  refundId           String?
  refundAmount       Float?        @default(0)
  failureReason      String?
  metadata           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ride               Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user               User          @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  audits             PaymentAudit[]

  @@index([userId])
  @@index([rideId])
  @@index([providerOrderId])
  @@index([status])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  provider    String    @default("RAZORPAY")
  eventType   String
  payload     String
  processed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([eventId])
}

model PaymentAudit {
  id           String        @id @default(cuid())
  paymentId    String
  bookingId    String
  action       String        // e.g. CREATED, CAPTURED, RECONCILED, REFUND_REQUESTED, REFUNDED, FAILED
  fromStatus   PaymentStatus?
  toStatus     PaymentStatus
  amount       Float?
  reason       String?
  source       String        // e.g. "CLIENT_CALLBACK", "WEBHOOK", "RECONCILIATION_CRON", "ADMIN_ACTION"
  metadata     String?       // JSON string for external IDs & debug details
  createdAt    DateTime      @default(now())

  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([bookingId])
  @@index([action])
}


