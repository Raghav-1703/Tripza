# The SQLite database file
DATABASE_URL="file:./dev.db"

# NextAuth secret for JWT signing
# Generate one using: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-here"

# The canonical URL of your site (NextAuth)
NEXTAUTH_URL="http://localhost:3000"

# Public Application Origin for Trip Sharing Links (REQUIRED)
# Single explicit configuration value used to construct secure tracking links.
#
# 1. Local computer development (same machine testing):
#    APP_URL="http://localhost:3000"
#
# 2. Local Wi-Fi network testing (for other phones/tablets on your Wi-Fi):
#    Find your computer's local Wi-Fi IP (run `ipconfig` on Windows, e.g. 192.168.0.101)
#    APP_URL="http://192.168.0.101:3000"
#
# 3. Production deployment (public deployed domain):
#    Must use HTTPS and cannot be localhost or a loopback address.
#    APP_URL="https://your-domain.com"
#
# NOTE: Restart the development server (`npm run dev`) whenever you change APP_URL.
APP_URL="http://localhost:3000"

# Emergency Email Notification (SMTP) Configuration (Optional)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
EMAIL_FROM="sos@tpool.local"

# Emergency SMS Notification Configuration (Optional)
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_FROM=""

# Payment Gateway Configuration (Razorpay Sandbox / Test Mode)
# Client-safe public key (used exclusively for checkout window initialization)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"

# Server-only secret keys (NEVER expose to the browser)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="placeholder_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_razorpay_webhook_secret"

